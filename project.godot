; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sword and Planet"
run/main_scene="res://scenes/opening/opening.tscn"
config/features=PackedStringArray("4.7")

[autoload]

TestBootstrap="*res://tests/test_bootstrap.gd"
InventorySystem="*res://scenes/inventory/inventory_system.tscn"
AffixPool="*res://scenes/inventory/affix_pool.tscn"
ItemTooltip="*res://addons/universal_inventory/scenes/item_tooltip.tscn"
AppConfig="*res://scenes/autoloads/app_config.tscn"
SceneLoader="*res://scenes/autoloads/scene_loader.tscn"
ProjectMusicController="*res://addons/maaacks_game_template/base/nodes/autoloads/music_controller/project_music_controller.tscn"
ProjectUISoundController="*res://addons/maaacks_game_template/base/nodes/autoloads/ui_sound_controller/project_ui_sound_controller.tscn"

[editor_plugins]

enabled=PackedStringArray("res://addons/mikeys_basic_ai/plugin.cfg", "res://addons/mikeys_basic_networking/plugin.cfg", "res://addons/mikeys_game_bones/plugin.cfg", "res://addons/maaacks_game_template/plugin.cfg")

