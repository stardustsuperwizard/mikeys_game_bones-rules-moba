; Engine configuration file.
; It's best edited using the editor and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section]
;   param=value

config_version=5

[application]

config/name="Sword and Planet"
run/main_scene="res://scenes/main.tscn"

[editor_plugins]

enabled=PackedStringArray("res://addons/mikeys_basic_ai/plugin.cfg", "res://addons/mikeys_basic_networking/plugin.cfg", "res://addons/mikeys_game_bones/plugin.cfg")
