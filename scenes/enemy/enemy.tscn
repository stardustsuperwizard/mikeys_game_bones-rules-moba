position = Vector3(0, 1, -0.55)

[node name="Controller" type="Node" parent="."]
script = ExtResource("3")

[node name="MobaCombatant" type="Node" parent="."]
script = ExtResource("5")
loadout = ExtResource("6")
respawn_policy = ExtResource("9")

; Server-authoritative combat state. Deliberately a child of MobaCombatant:
; WorldManager._spawn_actor() sets that node's authority to 1 recursively, so
; this synchronizer inherits it. Parented to the Actor root instead, the
; earlier recursive set_multiplayer_authority(authority_id) would leave it
; owned by the connecting peer and a client could broadcast its own health.
; root_path reaches back up to the Actor so one config covers MobaCombatant
; and its sibling MobaStateMachine.
[node name="CombatStateSynchronizer" type="MultiplayerSynchronizer" parent="MobaCombatant"]
root_path = NodePath("../..")
replication_config = SubResource("SceneReplicationConfig_combat")

[node name="MobaStateMachine" type="Node" parent="."]
script = ExtResource("7")

[node name="MobaAbilityCaster" type="Node" parent="."]
script = ExtResource("8")

; Transform: continuous, owning-peer-authoritative. Under the Actor root, so
; the recursive set_multiplayer_authority(authority_id) leaves it owned by
; whichever peer owns this actor -- today's movement-authority model.
[node name="BodyTransformSynchronizer" type="MultiplayerSynchronizer" parent="."]
replication_config = SubResource("SceneReplicationConfig_body")
