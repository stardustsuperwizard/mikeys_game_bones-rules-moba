[gd_scene load_steps=2 format=3 uid="uid://d4wl6vq66ib1cv3"]

[ext_resource type="Script" path="res://scripts/pause_menu.gd" id="1"]

; A CanvasLayer, not a bare Control: the combat HUD
; (rules/ui/moba_combat_hud.tscn) is itself a CanvasLayer on the default
; layer 1, and a plain Control draws on layer 0 -- underneath it. The pause
; overlay has to cover the HUD, so it takes a higher layer of its own.
;
; process_mode = 3 is PROCESS_MODE_ALWAYS, set here rather than in code so the
; scene declares it: with the tree paused, only ALWAYS nodes still receive
; _input(), and without it Escape could open the overlay but never close it.
[node name="PauseMenu" type="CanvasLayer"]
layer = 10
process_mode = 3
visible = false
script = ExtResource("1")

[node name="Overlay" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Dim" type="ColorRect" parent="Overlay"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.5)

[node name="Center" type="CenterContainer" parent="Overlay"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Overlay/Center"]
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="Overlay/Center/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 24

[node name="Buttons" type="VBoxContainer" parent="Overlay/Center/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Overlay/Center/Panel/Margin/Buttons"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Paused"
horizontal_alignment = 1

[node name="ResumeButton" type="Button" parent="Overlay/Center/Panel/Margin/Buttons"]
layout_mode = 2
text = "Resume"

[node name="QuitButton" type="Button" parent="Overlay/Center/Panel/Margin/Buttons"]
layout_mode = 2
text = "Quit to Main Menu"
