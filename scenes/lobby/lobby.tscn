; The single trigger #350 asks for, and deliberately nothing more -- no ready
; check, no countdown, no roster. Any peer present may press it; the server is
; what decides whether the request becomes a match.
[node name="StartMatchButton" type="Button" parent="CanvasLayer"]
offset_left = 16.0
offset_top = 16.0
offset_right = 216.0
offset_bottom = 56.0
text = "Start Match"

; Resolved in the camera's own _ready(), which runs after LobbyManager's --
; by then LobbyManager has spawned this peer's own avatar, and it is the only
; one present. Exactly how scenes/main.tscn points at ../WorldManager/Player/Body.
[node name="ThirdPersonCamera" type="Camera3D" parent="."]
script = ExtResource("2")
target_path = NodePath("../LobbyManager/LobbyAvatar/Body")
