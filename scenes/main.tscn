[node name="MatchController" type="Node" parent="."]
script = ExtResource("13")

; Authored in the scene rather than created by MatchController._ready(): a
; MultiplayerSynchronizer resolves its replication config when it readies, and
; a child readies before its parent, so a state node built from code would not
; exist yet at the path the config names.
[node name="MobaMatchState" type="Node" parent="MatchController"]
script = ExtResource("14")
rules = ExtResource("15")

; Server-authoritative round and match state. Parented to MobaMatchState and
; reaching back up with root_path, the way CombatStateSynchronizer does in
; scenes/player/player.tscn, so the config paths stay node-qualified.
[node name="MatchStateSynchronizer" type="MultiplayerSynchronizer" parent="MatchController/MobaMatchState"]
root_path = NodePath("..")
replication_config = SubResource("SceneReplicationConfig_match")

