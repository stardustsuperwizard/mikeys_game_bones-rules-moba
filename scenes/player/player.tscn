[sub_resource type="SceneReplicationConfig" id="SceneReplicationConfig_body"]
properties/0/path = NodePath("Body:transform")
properties/0/spawn = true
properties/0/replication_mode = 1

[sub_resource type="SceneReplicationConfig" id="SceneReplicationConfig_combat"]
properties/0/path = NodePath("MobaCombatant:current_health")
properties/0/spawn = true
properties/0/replication_mode = 2
properties/1/path = NodePath("MobaCombatant:current_resource")
properties/1/spawn = true
properties/1/replication_mode = 2
properties/2/path = NodePath("MobaCombatant:active_shields_snapshot")
properties/2/spawn = true
properties/2/replication_mode = 2
properties/3/path = NodePath("MobaCombatant:active_effects_snapshot")
properties/3/spawn = true
properties/3/replication_mode = 2
properties/4/path = NodePath("MobaCombatant:active_cooldowns_snapshot")
properties/4/spawn = true
properties/4/replication_mode = 2
properties/5/path = NodePath("MobaStateMachine:current_state")
properties/5/spawn = true
properties/5/replication_mode = 2

[node name="Player" type="Node"]
script = ExtResource("1")
character_sheet = ExtResource("4")
color = Color(0.2, 0.5, 1.0, 1.0)
hostile = false

[node name="Body" type="CharacterBody3D" parent="."]
script = ExtResource("2")

[node name="CollisionShape3D" type="CollisionShape3D" parent="Body"]
shape = SubResource("CapsuleShape3D_1")
position = Vector3(0, 1, 0)

[node name="MeshInstance3D" type="MeshInstance3D" parent="Body"]
mesh = SubResource("CapsuleMesh_1")
position = Vector3(0, 1, 0)

[node name="FrontIndicator" type="MeshInstance3D" parent="Body"]
mesh = SubResource("BoxMesh_1")
material_override = SubResource("StandardMaterial3D_1")
position = Vector3(0, 1, -0.55)

; Placement markers for the placeholder appearance pieces (#377). Empty Node3Ds:
; ActorAppearance3D reads their local positions and hangs the chosen helm and
; chest scenes there, so a body can move a slot without a script change.
[node name="HelmAttachment" type="Node3D" parent="Body"]
position = Vector3(0, 1.95, 0)

[node name="ChestAttachment" type="Node3D" parent="Body"]
position = Vector3(0, 1.15, 0)

[node name="Controller" type="Node" parent="."]
script = ExtResource("3")

; The baked loadout is a design-time default only, and is no longer what a
; player plays. WorldManager._spawn_actor() overwrites it on every spawn with
; the build the server accepted for that peer -- or, for a peer that has not
; had one accepted, with rules/data/builds/melee_bruiser_build.tres. It is kept
; rather than cleared so this scene stays openable and previewable in the
; editor, and so anything instantiating player.tscn directly still gets a legal
; kit instead of a null loadout.
;
; The build reaches remote peers through the MultiplayerSpawner payload, not
; through the synchronizer below: spawn data is replayed by _spawn_actor() on
; every peer, so all of them construct the combatant from the same bytes. That
; is also why no loadout property is listed in the replication config -- a
; MobaLoadout is a Resource, and object decoding is off, so syncing it as a
; property would drop it on the wire.
[node name="MobaCombatant" type="Node" parent="."]
script = ExtResource("5")
loadout = ExtResource("6")
respawn_policy = ExtResource("9")

; Server-authoritative combat state. Deliberately a child of MobaCombatant:
; WorldManager._spawn_actor() sets that node's authority to 1 recursively, so
; this synchronizer inherits it. Parented to the Actor root instead, the
; earlier recursive set_multiplayer_authority(authority_id) would leave it
; owned by the connecting peer and a client could broadcast its own health.
; root_path reaches back up to the Actor so one config covers MobaCombatant
; and its sibling MobaStateMachine.
[node name="CombatStateSynchronizer" type="MultiplayerSynchronizer" parent="MobaCombatant"]
root_path = NodePath("../..")
replication_config = SubResource("SceneReplicationConfig_combat")

[node name="MobaStateMachine" type="Node" parent="."]
script = ExtResource("7")

[node name="MobaAbilityCaster" type="Node" parent="."]
script = ExtResource("8")

[node name="MobaInputRouter" type="Node" parent="."]
script = ExtResource("10")

[node name="MobaInputScheme" type="Node" parent="."]
script = ExtResource("11")

; Transform: continuous, owning-peer-authoritative. Under the Actor root, so
; the recursive set_multiplayer_authority(authority_id) leaves it owned by
; whichever peer owns this actor -- today's movement-authority model.
[node name="BodyTransformSynchronizer" type="MultiplayerSynchronizer" parent="."]
replication_config = SubResource("SceneReplicationConfig_body")
