# gdlint configuration for Sword and Planet.
#
# Only the keys below are overridden; every other rule keeps gdtoolkit's
# default, so this file does not freeze the rest of the ruleset in place.
#
# max-file-lines: raised from gdtoolkit's default of 1000.
#
# rules/core/moba_combatant.gd crossed 1000 in #230 (shield pool) and is the
# only file in the project above the default -- the next largest is
# rules/tests/ability_activation_test.gd at 874. The combatant is the MOBA
# rules hub (health, stats, damage pipeline, crowd control, displacement,
# shields), so it grows a little with each Batch 2 task while everything
# else stays well clear.
#
# 1200 keeps the gate meaningful for the rest of the project rather than
# disabling it: every other .gd file has at least 300 lines of headroom, so
# this only stops the combatant from failing the check on line count alone.
# Splitting MobaCombatant is still worth doing on its own terms -- this
# raises the threshold, it does not decide that question.
max-file-lines: 1200
