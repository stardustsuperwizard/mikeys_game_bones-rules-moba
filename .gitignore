# Shared project settings only. A cloud session reads .claude/settings.json
# out of the clone and does NOT read .claude/settings.local.json or
# ~/.claude/settings.json, so anything that must apply on a phone or on
# Claude Code for web has to be committed here. settings.local.json stays
# ignored on purpose -- it is the personal override.
!.claude/settings.json
.DS_Store
private/
private/**


# Python bytecode from repository tooling
__pycache__/
*.pyc

# Python virtual environments and test artifacts
venv/
.venv/
env/
.env/
.pytest_cache/
.hypothesis/

# setuptools build output for the `sim/` package (sim/pyproject.toml). These
# are regenerated by any install or build and were previously committed at
# both the repo root and sim/ -- ten files that `git ls-files` reported as
# source. That matters beyond tidiness: agent-01-planner.yml builds its file
# inventory from `git ls-files` precisely to avoid egg-info noise ("Tracked
# files are exactly the ones a plan may target"), and tracking them defeated
# the workaround.
#
# `*.egg-info/` stays unanchored: setuptools writes it wherever a build runs,
# and no Godot path is named that. `build/` and `dist/` are anchored to the
# two directories that can actually build -- the repo root and `sim/` -- so
# they cannot silently swallow a future `scenes/build/` or an addon shipping
# a `dist/`. There is no `export_presets.cfg` yet; when there is, an export
# path will not collide with these.
*.egg-info/
/build/
/dist/
/sim/build/
/sim/dist/

# Generated rules data (Python harness only)
rules/data/generated/

# Scratch files written at repo root by the planner/implementor/reviewer/fixer
# GitHub Actions pipeline (.github/workflows/agent-*.yml, .github/actions/).
# These are ephemeral CI-run artifacts, never meant to be committed -- but
# an agent session running with repo-root as its cwd can see them and sweep
# them into its own `git add -A` if they aren't ignored, which trips the
# "Check For Commit" clean-tree gate. See run-agent-session/action.yml.
#
# THIS LIST IS LOAD-BEARING AND IS MATCHED BY LITERAL NAME. Renaming an
# artifact without renaming its entry here does not fail a check -- it means
# agent-02-implement.yml's "committing them so the work is not discarded" step
# sweeps the runner's own scratch into somebody's pull request. Grep for the
# name before you change it.

# Written by run-agent-session, whichever vendor answered.
agent-error.txt
agent-outcome.json
agent-assistant-text.txt
agent-final-text.txt
agent-session-failure.json

# Written only by the claude branch of run-agent-session.
claude-output.json

# Written by the copilot branch of run-agent-session, and by
# agent-01-planner.yml, which still carries its own copy of the session loop
# instead of calling the shared action. When the planner is migrated, the two
# entries that only it still writes -- copilot-error.txt and
# copilot-outcome.json -- go with it.
copilot-output.jsonl
copilot-error.txt
copilot-outcome.json
model-help.txt
implementor-prompt.txt
planner-prompt.txt
reviewer-prompt.txt
fixer-prompt.txt
