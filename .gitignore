# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Do not commit addon files
addons/*
!addons/mikeys_*

# Additional ignores
.claude/*
!.claude/agents/
!.claude/agents/**
!.claude/commands/
!.claude/commands/**
# Shared project settings only. A cloud session reads .claude/settings.json
# out of the clone and does NOT read .claude/settings.local.json or
# ~/.claude/settings.json, so anything that must apply on a phone or on
# Claude Code for web has to be committed here. settings.local.json stays
# ignored on purpose -- it is the personal override.
!.claude/settings.json
.DS_Store
private/
private/**


# Python bytecode from repository tooling
__pycache__/
*.pyc

# Python virtual environments and test artifacts
venv/
.venv/
env/
.env/
.pytest_cache/
.hypothesis/

# Generated rules data (Python harness only)
rules/data/generated/

# Scratch files written at repo root by the planner/executor/reviewer/fixer
# GitHub Actions pipeline (.github/workflows/agent-*.yml, .github/actions/).
# These are ephemeral CI-run artifacts, never meant to be committed -- but
# an agent session running with repo-root as its cwd can see them and sweep
# them into its own `git add -A` if they aren't ignored, which trips the
# "Check For Commit" clean-tree gate. See run-copilot-session/action.yml.
copilot-output.jsonl
copilot-error.txt
copilot-outcome.json
copilot-assistant-text.txt
copilot-final-text.txt
copilot-session-failure.json
model-help.txt
executor-prompt.txt
planner-prompt.txt
reviewer-prompt.txt
fixer-prompt.txt
issue.json
issue-body.md
task-scope.json
task.json
parent.json
plan.json
pr.json
pr-meta.json
pr-files.txt
pr-scope.json
comments.json
created-issues.json
closing-issues.json
args.json
args.jsonl
update-pr.json
executor-failure.json
planner-failure.json
fixer-failure.json
review-verdict-failure.json
